<mxfile host="drawio"><diagram id="direction" name="Keep K, drop Q"><mxGraphModel dx="960" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="980" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q" value="&lt;b&gt;Round one: the quadratic surrogate&lt;/b&gt;&lt;br&gt;Q(δ) = ½ δ&lt;sup&gt;T&lt;/sup&gt;F&lt;sub&gt;h&lt;/sub&gt;δ, curvature frozen at θ&lt;sub&gt;0&lt;/sub&gt;&lt;br&gt;token weight ∝ p(1−p) ≈ e&lt;sup&gt;−m&lt;/sup&gt;: blind to confident refusals&lt;br&gt;on a flipped refusal, K/Q = sinh(m&lt;sub&gt;0&lt;/sub&gt;)/m&lt;sub&gt;0&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="130" y="10" width="330" height="120" as="geometry"/></mxCell><mxCell id="k" value="&lt;b&gt;With more credits: the exact drift&lt;/b&gt;&lt;br&gt;K(θ) = E&lt;sub&gt;x&lt;/sub&gt; KL(p&lt;sub&gt;θ0&lt;/sub&gt; ‖ p&lt;sub&gt;θ&lt;/sub&gt;), curvature E Var&lt;sub&gt;p&lt;sub&gt;t&lt;/sub&gt;&lt;/sub&gt;(u)&lt;br&gt;grows as a refusal weakens&lt;br&gt;paid for with forward passes, not curvature" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="10" width="410" height="120" as="geometry"/></mxCell><mxCell id="ek" value="&lt;b&gt;keep K,&lt;br&gt;drop Q&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q" target="k"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u0" value="&lt;b&gt;Forecast&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="160" width="110" height="80" as="geometry"/></mxCell><mxCell id="o0" value="Q(Δ)&lt;br&gt;&lt;i&gt;24–111× too low on Tiny Aya&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="130" y="160" width="330" height="80" as="geometry"/></mxCell><mxCell id="n0" value="K&lt;sub&gt;lin&lt;/sub&gt;(1) from one JVP × measured non-linearity (E1)&lt;br&gt;&lt;i&gt;pilot: the 1,200–12,000× gap splits into both&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="410" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o0" target="n0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;Repair&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="254" width="110" height="80" as="geometry"/></mxCell><mxCell id="o1" value="argmin Q(Δ′) + μR(Δ′ − Δ)&lt;br&gt;&lt;i&gt;oblique steps up to 94×&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="130" y="254" width="330" height="80" as="geometry"/></mxCell><mxCell id="n1" value="min over s ∈ [0,1]&lt;sup&gt;252&lt;/sup&gt; of K(θ&lt;sub&gt;0&lt;/sub&gt; + Σ s&lt;sub&gt;m&lt;/sub&gt;ΔW&lt;sub&gt;m&lt;/sub&gt;) + μL,&lt;br&gt;from the best WiSE-FT point (E2)&lt;br&gt;&lt;i&gt;pilot: 0.2–8.6% harmful vs 25–99% for WiSE-FT&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="254" width="410" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;Fine-tune safely&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="348" width="110" height="80" as="geometry"/></mxCell><mxCell id="o2" value="L&lt;sub&gt;task&lt;/sub&gt; + λQ(θ − θ&lt;sub&gt;0&lt;/sub&gt;), i.e. EWC&lt;br&gt;&lt;i&gt;pilot: 78–100% harmful at every λ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="130" y="348" width="330" height="80" as="geometry"/></mxCell><mxCell id="n2" value="L&lt;sub&gt;task&lt;/sub&gt; + βK(θ), or L&lt;sub&gt;task&lt;/sub&gt; + β·E max(0, m* − m&lt;sub&gt;θ&lt;/sub&gt;) (E9)&lt;br&gt;&lt;i&gt;pilot: 0% harmful, task kept&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="348" width="410" height="80" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o2" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u3" value="&lt;b&gt;Curvature&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="442" width="110" height="80" as="geometry"/></mxCell><mxCell id="o3" value="in-sample generalised eigenvalues&lt;br&gt;&lt;i&gt;noise spreads them 16-fold&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="130" y="442" width="330" height="80" as="geometry"/></mxCell><mxCell id="n3" value="cross-fitted, shrunk eigenvalues (E3)&lt;br&gt;step ≤ (1 + πL&lt;sub&gt;B&lt;/sub&gt;/8)·‖Δ‖; WiSE-FT if no signal&lt;br&gt;&lt;i&gt;pilot: loses 4–12% vs 18–50%&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="442" width="410" height="80" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="o3" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>