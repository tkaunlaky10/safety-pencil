<mxfile host="drawio"><diagram id="framework" name="Safety Pencil framework"><mxGraphModel dx="960" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="980" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m0" value="&lt;b&gt;θ&lt;sub&gt;0&lt;/sub&gt;: aligned model&lt;/b&gt;&lt;br&gt;Tiny Aya Global, 3.3B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="10" y="30" width="190" height="70" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;θ&lt;sub&gt;1&lt;/sub&gt; = θ&lt;sub&gt;0&lt;/sub&gt; + Δ&lt;/b&gt;&lt;br&gt;after a benign fine-tune&lt;br&gt;&lt;i&gt;task NLL 2.14 → 1.78&lt;br&gt;EN harmful 6.6% → 22.5%&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="10" y="250" width="190" height="100" as="geometry"/></mxCell><mxCell id="e1" value="LoRA on 4,000&lt;br&gt;Hindi instructions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fh" value="&lt;b&gt;F&lt;sub&gt;h&lt;/sub&gt;: curvature of safety drift&lt;/b&gt;&lt;br&gt;Fisher at θ&lt;sub&gt;0&lt;/sub&gt;, harmful prompts&lt;br&gt;S(θ&lt;sub&gt;0&lt;/sub&gt;+Δ) ≈ ½ Δ&lt;sup&gt;T&lt;/sup&gt;F&lt;sub&gt;h&lt;/sub&gt;Δ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="20" width="210" height="90" as="geometry"/></mxCell><mxCell id="ht" value="&lt;b&gt;H&lt;sub&gt;t&lt;/sub&gt;: curvature of task loss&lt;/b&gt;&lt;br&gt;Fisher at θ&lt;sub&gt;1&lt;/sub&gt;, Hindi task rows&lt;br&gt;R(δ) = ½ δ&lt;sup&gt;T&lt;/sup&gt;H&lt;sub&gt;t&lt;/sub&gt;δ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="240" y="255" width="210" height="90" as="geometry"/></mxCell><mxCell id="kf" value="&lt;b&gt;Made computable with K-FAC&lt;/b&gt;&lt;br&gt;per layer F ≈ A ⊗ G, so&lt;br&gt;λ = α·γ from two small eigensolves;&lt;br&gt;covariant damping" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="135" width="210" height="95" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m0" target="fh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m1" target="ht"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pc" value="&lt;b&gt;The pencil&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&amp;quot;font-size:15px&amp;quot;&gt;F&lt;sub&gt;h&lt;/sub&gt; v = λ H&lt;sub&gt;t&lt;/sub&gt; v&lt;/span&gt;&lt;br&gt;&lt;br&gt;λ = safety damage / task cost&lt;br&gt;along direction v&lt;br&gt;&lt;br&gt;c = V&lt;sup&gt;T&lt;/sup&gt;H&lt;sub&gt;t&lt;/sub&gt;Δ: the update&#x27;s&lt;br&gt;coordinates in that basis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="490" y="95" width="200" height="170" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fh" target="pc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ht" target="pc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lo" value="&lt;b&gt;Locate&lt;/b&gt;&lt;br&gt;largest λ per module&lt;br&gt;= leverage map, &lt;i&gt;✓ layers 32–35&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="730" y="10" width="220" height="80" as="geometry"/></mxCell><mxCell id="fc" value="&lt;b&gt;Forecast&lt;/b&gt;&lt;br&gt;S ≈ ½ Σ&lt;sub&gt;i&lt;/sub&gt; λ&lt;sub&gt;i&lt;/sub&gt; c&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;&lt;i&gt;✗ 24–111× too low; real drift&lt;br&gt;∝ (1−α)&lt;sup&gt;0.72&lt;/sup&gt;, not (1−α)&lt;sup&gt;2&lt;/sup&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="730" y="115" width="220" height="105" as="geometry"/></mxCell><mxCell id="rp" value="&lt;b&gt;Repair&lt;/b&gt;&lt;br&gt;z&lt;sub&gt;i&lt;/sub&gt; = μ/(λ&lt;sub&gt;i&lt;/sub&gt;+μ) · c&lt;sub&gt;i&lt;/sub&gt;&lt;br&gt;+ trust region t&lt;sub&gt;k&lt;/sub&gt; = min(1, 1/r&lt;sub&gt;k&lt;/sub&gt;)&lt;br&gt;&lt;i&gt;✓ EN harmful 22.5% → 7.4%,&lt;br&gt;no task loss&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="730" y="245" width="220" height="115" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="pc" target="lo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="pc" target="fc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.4;" edge="1" parent="1" source="pc" target="rp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="wi" value="&lt;b&gt;Special case: WiSE-FT&lt;/b&gt;&lt;br&gt;F&lt;sub&gt;h&lt;/sub&gt; = κH&lt;sub&gt;t&lt;/sub&gt; (all λ equal)&lt;br&gt;⇒ Δ′ = μ/(κ+μ) · Δ&lt;br&gt;&lt;i&gt;ties the repair; half its over-refusal&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="395" width="220" height="95" as="geometry"/></mxCell><mxCell id="e9" value="simplest&lt;br&gt;curvature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="rp" target="wi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="iv" value="&lt;b&gt;Exact gauge invariance&lt;/b&gt;&lt;br&gt;proved for the V/O symmetry&lt;br&gt;&lt;i&gt;✓ measured KL ≤ 2×10&lt;sup&gt;−9&lt;/sup&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="290" width="200" height="70" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="pc" target="iv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bs" value="&lt;b&gt;Why the forecast fails: the confidence blind spot&lt;/b&gt; (§6.1, §8)&lt;br&gt;a token&#x27;s Fisher weight ∝ p(1−p) ≈ e&lt;sup&gt;−m&lt;/sup&gt;, tiny on confident refusals;&lt;br&gt;when the update flips one, true KL / ½Δ&lt;sup&gt;T&lt;/sup&gt;FΔ = sinh(m&lt;sub&gt;0&lt;/sub&gt;)/m&lt;sub&gt;0&lt;/sub&gt;&lt;br&gt;(11× at p = 0.99, 72× at p = 0.999)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="240" y="395" width="450" height="95" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;exitX=1;exitY=0.25;entryX=0;entryY=0.75;" edge="1" parent="1" source="bs" target="fc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Evaluation (AuditKIT)&lt;/b&gt;: Llama Guard 3 → harmful compliance · Aya Expanse 8B → refusal and over-refusal · KL drift S on dev · Hindi task NLL · per language (en, hi, Hinglish) · test split touched once" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=13;fontFamily=Helvetica;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="520" width="940" height="55" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="m1" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.893;entryY=0;" edge="1" parent="1" source="wi" target="ev"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>