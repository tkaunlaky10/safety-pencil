+_WEIGHT_FILE_PATTERNS = ("*.safetensors", "*.bin", "*.pt", "adapter_model.*",
+                         "adapter_config.json", "config.json")
+
+
+def _local_weights_signature(path: Any) -> Optional[list]:
+    """``[name, size, mtime_ns]`` per weight file at a local *path*, or None.
+
+    A cheap stand-in for hashing the weights: a file path signs itself, a
+    directory signs its top-level files matching ``_WEIGHT_FILE_PATTERNS``.
+    Anything that isn't an existing local path (a hub id, a URL) returns None,
+    as does a directory with no such files, leaving the identity unchanged.
+    """
+    if not isinstance(path, str) or not path:
+        return None
+    try:
+        if os.path.isfile(path):
+            st = os.stat(path)
+            return [[os.path.basename(path), st.st_size, st.st_mtime_ns]]
+        if not os.path.isdir(path):
+            return None
+        sig = []
+        with os.scandir(path) as entries:
+            for entry in entries:
+                if entry.is_file() and any(fnmatch.fnmatchcase(entry.name, p) for p in _WEIGHT_FILE_PATTERNS):
+                    st = entry.stat()
+                    sig.append([entry.name, st.st_size, st.st_mtime_ns])
+    except OSError:
+        return None
+    return sorted(sig) or None
 
 
