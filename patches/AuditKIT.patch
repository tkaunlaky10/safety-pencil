+class TestLocalCheckpointWeightsInIdentity:
+    """A local checkpoint retrained in place keeps its path, so the model's
+    identity also folds in its weight files' names/sizes/mtimes."""
+
+    def test_retraining_in_place_changes_the_identity(self, tmp_path):
+        from auditkit.model import AutoModel
+
+        weights = tmp_path / "model.safetensors"
+        weights.write_bytes(b"old")
+        (tmp_path / "README.md").write_text("not a weight file")
+        before = AutoModel.resolve(f"hf:{tmp_path}").identity()
+        weights.write_bytes(b"retrained")
+        after = AutoModel.resolve(f"hf:{tmp_path}").identity()
+        assert before != after
+        assert [entry[0] for entry in after["weights"]] == ["model.safetensors"]
+        assert AutoModel.resolve(f"hf:{weights}").identity()["weights"][0][0] == "model.safetensors"
+
+    def test_hub_id_identity_is_unchanged(self):
+        from auditkit.model import AutoModel
+
+        assert AutoModel.resolve("hf:org/not-a-local-path").identity() == {
+            "name": "hf:org/not-a-local-path", "model": "org/not-a-local-path"}
+
+
+class TestRunCacheOptOut:
+    """AUDITKIT_DISABLE_RUN_CACHE skips both reading and writing the run cache."""
+
+    @pytest.mark.parametrize("value,enabled", [
+        (None, True), ("", True), ("0", True), ("false", True),
+        ("1", False), ("true", False), ("YES", False), (" yes ", False),
+    ])
+    def test_env_values(self, monkeypatch, value, enabled):
+        from auditkit.cache import run_cache_enabled
+
+        monkeypatch.delenv("AUDITKIT_DISABLE_RUN_CACHE", raising=False)
+        if value is not None:
+            monkeypatch.setenv("AUDITKIT_DISABLE_RUN_CACHE", value)
+        assert run_cache_enabled() is enabled
+
+    def test_disabled_run_neither_reads_nor_writes(self, monkeypatch, tmp_path):
+        import auditkit as ak
+        from auditkit.runspec import RunConfig
+
+        monkeypatch.setenv("XDG_CACHE_HOME", str(tmp_path))
+        calls = []
+        model = lambda prompts: (calls.append(prompts), ["hi" for _ in prompts])[1]  # noqa: E731
+        cfg = RunConfig(concurrency=1)
+        samples = [Sample(input="hi", target="hi")]
+        ak.evaluate(samples, model=model, config=cfg)       # default: cache written
+        snapshot = lambda: {p: (p.stat().st_ino, p.stat().st_mtime_ns) for p in tmp_path.rglob("*.json")}  # noqa: E731
+        files = snapshot()
+        assert len(files) == 1
+        first = len(calls)
+
+        monkeypatch.setenv("AUDITKIT_DISABLE_RUN_CACHE", "1")
+        ak.evaluate(samples, model=model, config=cfg)
+        assert len(calls) == 2 * first                       # cached result not read
+        assert snapshot() == files                           # nor rewritten
+        monkeypatch.setenv("XDG_CACHE_HOME", str(tmp_path / "fresh"))
+        ak.evaluate(samples, model=model, config=cfg)
+        assert not (tmp_path / "fresh").exists()             # no cache dir created
