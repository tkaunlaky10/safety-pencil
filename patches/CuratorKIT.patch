diff --git a/curatorkit/exporters/prompts_meta.py b/curatorkit/exporters/prompts_meta.py
new file mode 100644
index 0000000..9a0705d
--- /dev/null
+++ b/curatorkit/exporters/prompts_meta.py
@@ -0,0 +1,84 @@
+"""
+PromptsMetaExporter — serialize prompts with their id, source and metadata.
+
+Output: {output_dir}/prompts_meta.jsonl
+Each line:
+    {
+        "id":         "<DataSample.id>",
+        "prompt":     "<DataSample.instruction>",
+        "task_type":  "prompt_only",
+        "source_uri": "<DataSample.source_uri>",
+        "metadata":   {"language": "...", "harm_category": "...", ...},
+        "input":      "...",   # only when the sample has a non-empty input
+        "output":     "..."    # only when the sample has a non-empty output
+    }
+
+PPOExporter writes only {"prompt"}, dropping the id, source and metadata
+(language, harm_category, ...) needed to stratify, split or audit a prompt
+set afterwards; this exporter keeps them.
+
+Every task_type in curatorkit.exporters.compatibility is accepted (see
+ANY_TASK_TYPE_EXPORT_FORMATS), but the format is never auto-selected: add
+"prompts_meta" to export_formats to get it. Samples with an empty
+instruction (e.g. language_modeling chunks) are skipped and counted in a
+warning.
+"""
+
+from __future__ import annotations
+
+import json
+import warnings
+from pathlib import Path
+
+from curatorkit.exporters.compatibility import is_compatible, task_types_for
+from curatorkit.interfaces import BaseExporter
+from curatorkit.schema import DataSample
+
+_FORMAT = "prompts_meta"
+
+
+class PromptsMetaExporter(BaseExporter):
+    """Export prompts with id, task_type, source_uri and metadata."""
+
+    filename = "prompts_meta.jsonl"
+    columns = {
+        "id, prompt, task_type, source_uri": "string",
+        "metadata": "object (DataSample.metadata as-is)",
+        "input, output": "string (only on rows whose sample has one)",
+    }
+
+    def export(self, samples: list[DataSample], output_dir: Path) -> None:
+        output_path = output_dir / self.filename
+        skipped = 0
+        exported = 0
+
+        with open(output_path, "w", encoding="utf-8") as f:
+            for sample in samples:
+                if not is_compatible(sample.task_type, _FORMAT) or not sample.instruction.strip():
+                    skipped += 1
+                    continue
+                record = {
+                    "id": sample.id,
+                    "prompt": sample.instruction,
+                    "task_type": sample.task_type,
+                    "source_uri": sample.source_uri,
+                    "metadata": sample.metadata or {},
+                }
+                if sample.input:
+                    record["input"] = sample.input
+                if sample.output:
+                    record["output"] = sample.output
+                # metadata is passed through from the source row, so it may hold
+                # values json can't encode natively (dates, ...): fall back to str.
+                f.write(json.dumps(record, ensure_ascii=False, default=str) + "\n")
+                exported += 1
+
+        if skipped:
+            task_types = {s.task_type for s in samples}
+            warnings.warn(
+                f"PromptsMetaExporter skipped {skipped}/{len(samples)} samples (wrote {exported}) — "
+                f"not task_type {task_types_for(_FORMAT)}, or empty instruction (sample "
+                f"task_type(s) seen: {sorted(task_types)}).",
+                UserWarning,
+                stacklevel=2,
+            )
diff --git a/tests/unit/test_prompts_meta_exporter.py b/tests/unit/test_prompts_meta_exporter.py
new file mode 100644
index 0000000..e0c2dd9
--- /dev/null
+++ b/tests/unit/test_prompts_meta_exporter.py
@@ -0,0 +1,99 @@
+"""Tests for PromptsMetaExporter (export_formats "prompts_meta"): prompts keep
+their id, task_type, source_uri and metadata, unlike ppo.jsonl's bare prompt."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from curatorkit.exporters import EXPORTERS
+from curatorkit.exporters.compatibility import (
+    TASK_TYPE_EXPORT_FORMATS,
+    is_compatible,
+    misaligned_formats,
+    resolve_export_formats,
+)
+from curatorkit.exporters.prompts_meta import PromptsMetaExporter
+from curatorkit.schema import DataSample
+
+
+def _rows(path):
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()]
+
+
+def test_registered_under_prompts_meta():
+    assert EXPORTERS["prompts_meta"] is PromptsMetaExporter
+
+
+def test_prompt_only_row_keeps_id_source_and_metadata(tmp_path):
+    sample = DataSample(
+        id="aya-hi-7",
+        source_uri="CohereForAI/aya_redteaming",
+        instruction="कोई हानिकारक प्रश्न?",
+        task_type="prompt_only",
+        metadata={"language": "Hindi", "harm_category": ["Violence"]},
+    )
+    PromptsMetaExporter().export([sample], tmp_path)
+    assert _rows(tmp_path / "prompts_meta.jsonl") == [
+        {
+            "id": "aya-hi-7",
+            "prompt": "कोई हानिकारक प्रश्न?",
+            "task_type": "prompt_only",
+            "source_uri": "CohereForAI/aya_redteaming",
+            "metadata": {"language": "Hindi", "harm_category": ["Violence"]},
+        }
+    ]
+    assert "कोई" in (tmp_path / "prompts_meta.jsonl").read_text(encoding="utf-8")
+
+
+def test_input_and_output_written_only_when_present(tmp_path):
+    samples = [
+        DataSample(source_uri="t", instruction="Q?", input="ctx", output="A.",
+                   task_type="instruction_following"),
+        DataSample(source_uri="t", instruction="Prompt", task_type="prompt_only"),
+    ]
+    PromptsMetaExporter().export(samples, tmp_path)
+    first, second = _rows(tmp_path / "prompts_meta.jsonl")
+    assert (first["input"], first["output"]) == ("ctx", "A.")
+    assert "input" not in second and "output" not in second
+
+
+def test_every_known_task_type_is_compatible_but_unknown_is_not():
+    for task_type in TASK_TYPE_EXPORT_FORMATS:
+        assert is_compatible(task_type, "prompts_meta")
+    assert not is_compatible("some_custom_type", "prompts_meta")
+    assert misaligned_formats("qa", ["alpaca", "prompts_meta"]) == []
+
+
+def test_never_auto_selected():
+    assert "prompts_meta" not in resolve_export_formats(None, {"prompt_only"})
+    assert "prompts_meta" not in resolve_export_formats("qa")
+
+
+def test_empty_prompt_and_unknown_task_type_are_skipped_and_warn(tmp_path):
+    samples = [
+        DataSample(source_uri="t", output="chunk text", task_type="language_modeling"),
+        DataSample(source_uri="t", instruction="Q?", task_type="some_custom_type"),
+        DataSample(source_uri="t", instruction="Keep me", task_type="prompt_only"),
+    ]
+    with pytest.warns(UserWarning, match=r"PromptsMetaExporter skipped 2/3"):
+        PromptsMetaExporter().export(samples, tmp_path)
+    assert [r["prompt"] for r in _rows(tmp_path / "prompts_meta.jsonl")] == ["Keep me"]
+
+
+def test_output_split_writes_prompts_meta_per_split(tmp_path):
+    from curatorkit.curator import Curator, CuratorConfig
+
+    samples = [
+        DataSample(source_uri="t", instruction=f"P{i}", task_type="prompt_only",
+                   metadata={"language": "English"})
+        for i in range(10)
+    ]
+    curator = Curator(CuratorConfig(
+        output_dir=str(tmp_path), export_formats=["prompts_meta"],
+        output_split={"factor": 0.6, "dev": 0.2, "test": 0.2},
+    ))
+    curator._export_splits(samples, tmp_path)
+    counts = {s: len(_rows(tmp_path / s / "prompts_meta.jsonl")) for s in ("factor", "dev", "test")}
+    assert counts == {"factor": 6, "dev": 2, "test": 2}
