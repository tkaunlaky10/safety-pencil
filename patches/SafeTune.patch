+    # A tied weight (embed_tokens / lm_head) appears under several names but is one
+    # tensor: extrapolate it once and give its aliases the same result, so a later
+    # alias cannot overwrite it (load_state_dict: last write wins).
+    processed = {}  # (data_ptr, shape) -> name
 
     for name, w in w_model.items():
+        key = (w.data_ptr(), w.shape) if torch.is_tensor(w) else None
+        if key in processed:
+            new_state_dict[name] = new_state_dict[processed[key]]
+            continue
         # Default: keep the model's own weight (the LoX base point).
         new_state_dict[name] = w
 
